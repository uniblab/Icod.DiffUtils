<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<LangVersion>13.0</LangVersion>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<IsPackable>true</IsPackable>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
		<PackageType>DotnetTool</PackageType>
		<PackageId>Icod.DiffUtils.Executables</PackageId>
		<Version>1.0.0</Version>
		<PackageVersion>1.0.0</PackageVersion>
		<Authors>Timothy J. Bruce</Authors>
		<Description>Mixed-mode Icod Diffutils tool package exposing diffutil, cmp, diff, diff3, and sdiff.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageReleaseNotes>Initial multi-command executable distribution.</PackageReleaseNotes>
		<PackageTags>diff;diffutils;cmp;diff3;sdiff;gnu;cli;tool</PackageTags>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectMultiCommandToolPayload</TargetsForTfmSpecificContentInPackage>
		<MultiCommandToolPublishDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/obj/multitool/$(Configuration)/$(TargetFramework)/'))</MultiCommandToolPublishDir>
		<ArchiveOutputDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../artifacts/$(Configuration)/'))</ArchiveOutputDir>
		<ArchiveSelfContained Condition=" '$(ArchiveSelfContained)' == '' ">false</ArchiveSelfContained>
	</PropertyGroup>
	<ItemGroup>
		<_ToolProject Include="..\cmp\Icod.DiffUtils.Cmp.csproj" />
		<_ToolProject Include="..\diff\Icod.DiffUtils.Diff.csproj" />
		<_ToolProject Include="..\diff3\Icod.DiffUtils.Diff3.csproj" />
		<_ToolProject Include="..\sdiff\Icod.DiffUtils.SDiff.csproj" />
		<_ToolProject Include="..\diffutil\Icod.DiffUtils.DiffUtil.csproj" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="@(_ToolProject)" ReferenceOutputAssembly="false" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE" Link="LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<Target Name="PrepareMultiCommandToolPayload">
		<RemoveDir Directories="$(MultiCommandToolPublishDir)" />
		<MakeDir Directories="$(MultiCommandToolPublishDir)" />
		<MSBuild
			Projects="@(_ToolProject)"
			Targets="Publish"
			BuildInParallel="false"
			Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);PublishDir=$(MultiCommandToolPublishDir);UseAppHost=false;SelfContained=false"
		/>
		<Error Condition=" !Exists('$(MultiCommandToolPublishDir)diffutil.dll') " Text="diffutil.dll was not produced for the multi-command package." />
		<Error Condition=" !Exists('$(MultiCommandToolPublishDir)cmp.dll') " Text="cmp.dll was not produced for the multi-command package." />
		<Error Condition=" !Exists('$(MultiCommandToolPublishDir)diff.dll') " Text="diff.dll was not produced for the multi-command package." />
		<Error Condition=" !Exists('$(MultiCommandToolPublishDir)diff3.dll') " Text="diff3.dll was not produced for the multi-command package." />
		<Error Condition=" !Exists('$(MultiCommandToolPublishDir)sdiff.dll') " Text="sdiff.dll was not produced for the multi-command package." />
	</Target>

	<Target Name="CollectMultiCommandToolPayload" DependsOnTargets="PrepareMultiCommandToolPayload">
		<ItemGroup>
			<TfmSpecificPackageFile Include="$(MultiCommandToolPublishDir)**/*">
				<PackagePath>tools/$(TargetFramework)/any/%(RecursiveDir)</PackagePath>
			</TfmSpecificPackageFile>
			<TfmSpecificPackageFile Include="$(MSBuildProjectDirectory)/DotnetToolSettings.xml">
				<PackagePath>tools/$(TargetFramework)/any/</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>

	<Target Name="CreateArchive">
		<Error Condition=" '$(ArchiveRuntimeIdentifier)' == '' " Text="Specify -p:ArchiveRuntimeIdentifier=&lt;rid&gt;, for example win-x64, linux-x64, or osx-x64." />
		<PropertyGroup>
			<ArchiveStageDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/obj/archive/$(Configuration)/$(ArchiveRuntimeIdentifier)/'))</ArchiveStageDir>
			<ArchiveFile>$(ArchiveOutputDir)Icod.DiffUtils-$(PackageVersion)-$(ArchiveRuntimeIdentifier).zip</ArchiveFile>
		</PropertyGroup>
		<RemoveDir Directories="$(ArchiveStageDir)" />
		<MakeDir Directories="$(ArchiveStageDir)" />
		<MSBuild
			Projects="@(_ToolProject)"
			Targets="Restore"
			BuildInParallel="false"
			Properties="TargetFramework=$(TargetFramework);RuntimeIdentifier=$(ArchiveRuntimeIdentifier);SelfContained=$(ArchiveSelfContained)"
		/>
		<MSBuild
			Projects="@(_ToolProject)"
			Targets="Publish"
			BuildInParallel="false"
			Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(ArchiveRuntimeIdentifier);SelfContained=$(ArchiveSelfContained);UseAppHost=true;PublishDir=$(ArchiveStageDir)"
		/>
		<MakeDir Directories="$(ArchiveOutputDir)" />
		<ZipDirectory SourceDirectory="$(ArchiveStageDir)" DestinationFile="$(ArchiveFile)" Overwrite="true" />
		<Message Importance="high" Text="Created $(ArchiveFile)" />
	</Target>
</Project>
